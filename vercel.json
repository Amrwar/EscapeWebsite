{
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    { "source": "/barbers.html", "destination": "/behind-the-chair", "permanent": true },
    { "source": "/barbers", "destination": "/behind-the-chair", "permanent": true },
    { "source": "/team", "destination": "/behind-the-chair", "permanent": false },
    { "source": "/booking", "destination": "/book", "permanent": false },
    { "source": "/prices", "destination": "/services", "permanent": false },
    { "source": "/menu", "destination": "/services", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|mp4)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
